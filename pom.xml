	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<testFailureIgnore>true</testFailureIgnore>
					<skipTests>true</skipTests>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>build-helper-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>timestamp-property</id>
						<goals>
							<goal>timestamp-property</goal>
						</goals>
						<phase>validate</phase>
						<configuration>
							<name>date</name>
							<pattern>yyMMdd</pattern>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-antrun-plugin</artifactId>
				<executions>
					<execution>
						<phase>install</phase>
						<goals>
							<goal>run</goal>
						</goals>
						<configuration>
							<target>
								<echo message=""/>
								<echo message="Step 1. Delete old files"/>
								<delete file="${project.basedir}\target\dist\" />

								<echo message=""/>
								<echo message="Step 2. Copy resource files"/>
								<mkdir dir="${project.basedir}\target\dist\"/>
								<mkdir dir="${project.basedir}\target\dist\init"/>
								<mkdir dir="${project.basedir}\target\dist\logs"/>
								<mkdir dir="${project.basedir}\target\dist\lib"/>
								<mkdir dir="${project.basedir}\target\dist\mibs"/>

								<copydir src="${project.basedir}\dist\" dest="${project.basedir}\target\dist\"/>

								<copy file="${project.basedir}\target\${project.artifactId}-${project.version}.war" tofile="${project.basedir}\target\dist\lib\${project.artifactId}-${project.version}.war" />
								<copy file="${project.basedir}\src\main\resources\com/xcurenet/files/regexes.yaml" tofile="${project.basedir}\target\dist\conf\regexes.yaml" />
								<copy file="${project.basedir}\src\main\resources\com/xcurenet/files/css/pdf.css" tofile="${project.basedir}\target\dist\conf\regexes.yaml" />
								<copy file="${project.basedir}\src\main\resources\com/xcurenet/files/font/dotum.ttf" tofile="${project.basedir}\target\dist\conf\regexes.yaml" />

								<copy file="${project.basedir}\src\main\resources\com/xcurenet/sqlmap/mappers/sql/create_table.sql" tofile="${project.basedir}\target\dist\conf\create_table.sql" />
								<copy file="${project.basedir}\src\main\resources\com/xcurenet/sqlmap/mappers/sql/insert_data.sql" tofile="${project.basedir}\target\dist\conf\insert_data.sql" />
								<copy file="${project.basedir}\src\main\resources\com/xcurenet/sqlmap/mappers/sql/patch_data.sql" tofile="${project.basedir}\target\dist\conf\patch_data.sql" />
								<copy file="${project.basedir}\src\main\resources\com/xcurenet/sqlmap/mappers/sql/procedure.sql" tofile="${project.basedir}\target\dist\conf\procedure.sql" />
								<copy file="${project.basedir}\src\main\resources\com/xcurenet/sqlmap/mappers/sql/Update_Query_en.sql" tofile="${project.basedir}\target\dist\conf\Update_Query_en.sql" />
								<copy file="${project.basedir}\src\main\resources\com/xcurenet/sqlmap/mappers/sql/Update_Query_ko.sql" tofile="${project.basedir}\target\dist\conf\Update_Query_ko.sql" />

								<echo message=""/>
								<echo message="Step 3. Remove remote old files"/>
								<sshexec host="${buildHost}" username="${buildUser}" password="${buildPassword}" command="rm -rf ${binary-dir}" trust="yes" verbose="false"/>


								<echo message=""/>
								<echo message="Step 4. Project file upload"/>
								<sshexec host="${buildHost}" username="${buildUser}" password="${buildPassword}" command="mkdir -p ${binary-dir}/${project.artifactId}-skel${copy-dir}/logs" trust="yes" verbose="false"/>
								<sshexec host="${buildHost}" username="${buildUser}" password="${buildPassword}" command="mkdir -p ${binary-dir}/${project.artifactId}-skel${copy-dir}/init" trust="yes" verbose="false"/>
								<scp todir="${buildUser}:${buildPassword}@${buildHost}:${binary-dir}/" trust="yes" verbose="false">
									<fileset dir="${project.basedir}\rpm\"/>
								</scp>
								<scp todir="${buildUser}:${buildPassword}@${buildHost}:${binary-dir}/${project.artifactId}-skel/${copy-dir}" trust="yes" verbose="false">
									<fileset dir="${project.basedir}\target\dist\"/>
								</scp>


								<echo message=""/>
								<echo message="Step 5. RPM privilege setting"/>
								<sshexec host="${buildHost}" username="${buildUser}" password="${buildPassword}" command="chmod 755 ${binary-dir}/${project.artifactId}-skel${copy-dir}/bin/${project.artifactId}" trust="yes" verbose="false"/>
								<sshexec host="${buildHost}" username="${buildUser}" password="${buildPassword}" command="chmod 755 ${binary-dir}/${project.artifactId}-skel/etc/init.d/${project.artifactId}" trust="yes" verbose="false"/>
								<sshexec host="${buildHost}" username="${buildUser}" password="${buildPassword}" command="chmod 755 ${binary-dir}/rpmwand" trust="yes" verbose="false"/>


								<echo message=""/>
								<echo message="Step 6. RPM build"/>
								<sshexec host="${buildHost}" username="${buildUser}" password="${buildPassword}" command="${binary-dir}/rpmwand files ${binary-dir}/${project.artifactId}" trust="yes" verbose="false"/>
								<sshexec host="${buildHost}" username="${buildUser}" password="${buildPassword}" command="cd ${binary-dir} &amp;&amp; ./rpmwand build ${project.artifactId} ${project.version} ${release.version} ${arch}" trust="yes" verbose="false"/>

								<mkdir dir="${project.basedir}\target\RPMS\"/>
								<sshexec host="${buildHost}" username="${buildUser}" password="${buildPassword}" command="mv ${binary-dir}/RPMS/${arch}/${project.artifactId}-${project.version}-${release.version}.${arch}.rpm ${binary-dir}/RPMS/${arch}/${rpm-name}" trust="yes" verbose="false"/>


								<echo message="Step 7. RPM file download"></echo>
								<sshexec host="${buildHost}" username="${buildUser}" password="${buildPassword}" command="cd ${binary-dir}/RPMS/${arch}/ &amp;&amp; md5sum ${rpm-name} > ${rpm-name}.md5" trust="yes" verbose="false"/>
								<scp file="${buildUser}:${buildPassword}@${buildHost}:${binary-dir}/RPMS/${arch}/${rpm-name}" todir="./target/RPMS/" trust="yes" verbose="false"/>
								<scp file="${buildUser}:${buildPassword}@${buildHost}:${binary-dir}/RPMS/${arch}/${rpm-name}.md5" todir="./target/RPMS/" trust="yes" verbose="false"/>



								<!-- 개발 테스트 용 ( 테스트 장비의 war 교체 ) -->
								<!--								<echo message="Step 8. WAR file move"></echo>
																<scp todir="${buildUser}:${buildPassword}@${buildHost}:${copy-dir}/lib/" trust="yes" verbose="false">
																	<fileset dir="${project.basedir}\target\dist\lib\"/>
																</scp>
																<sshexec host="${buildHost}" username="${buildUser}" password="${buildPassword}" command="service ${project.artifactId} stop" trust="yes" verbose="false"/>
																<sshexec host="${buildHost}" username="${buildUser}" password="${buildPassword}" command="service ${project.artifactId} start" trust="yes" verbose="false"/>-->

								<echo message=""/>
								<echo message="Success Build"/>
							</target>
						</configuration>
					</execution>
				</executions>
