<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE tiles-definitions PUBLIC
        "-//Apache Software Foundation//DTD Tiles Configuration 3.0//EN"
        "http://tiles.apache.org/dtds/tiles-config_3_0.dtd">
<tiles-definitions>


    <!-- no layout-->
    <definition name="noLayout" template="/WEB-INF/layout/noLayout.jsp">
        <put-attribute name="body" value="" />
    </definition>


    <!-- popup layout-->
    <definition name="popupLayout" template="/WEB-INF/layout/popupLayout.jsp">
        <put-attribute name="baseCss" value="/WEB-INF/fragments/baseCss.jsp" />
        <put-attribute name="baseJs" value="/WEB-INF/fragments/baseJs.jsp" />
        <put-attribute name="body" value="" />
    </definition>

    <!-- 기본 레이아웃 -->
    <definition name="defaultLayout" template="/WEB-INF/layout/newLayout.jsp">
        <!-- 페이지 기본 CSS/JSS-->
        <put-attribute name="baseCss" value="/WEB-INF/fragments/baseCss.jsp" />
        <put-attribute name="baseJs" value="/WEB-INF/fragments/baseJs.jsp" />

        <put-attribute name="top" value="/WEB-INF/fragments/new_top.jsp" />
        <put-attribute name="header" value="/WEB-INF/fragments/header.jsp" />
        <put-attribute name="lnb" value="/WEB-INF/fragments/new_left.jsp" />
        <put-attribute name="footer" value="/WEB-INF/fragments/footer.jsp" />

        <put-attribute name="content" value="" />
    </definition>


    <!-- messageLayout  -->
    <definition name="messageLayout" template="/WEB-INF/views/emass/message/messageNewN.jsp">
        <!-- 페이지 기본 CSS/JSS-->
        <put-attribute name="messageCss" value="/WEB-INF/fragments/messageCss.jsp" />
        <put-attribute name="messageJs" value="/WEB-INF/fragments/messageJs.jsp" />


        <put-attribute name="top" value="/WEB-INF/fragments/new_top.jsp" />
        <put-attribute name="header" value="/WEB-INF/fragments/messageHeader.jsp" />
        <put-attribute name="lnb" value="/WEB-INF/fragments/new_left.jsp" />
        <put-attribute name="footer" value="/WEB-INF/fragments/footer.jsp" />
        <put-attribute name="left" value="/WEB-INF/views/emass/left.jsp" />
        <put-attribute name="filterNew" value="/WEB-INF/views/emass/message/filterNew.jsp" />

        <put-attribute name="content" value="" />

    </definition>




    <!-- 로그인 관련 layout 적용 제외-->
    <definition name="/login" extends="noLayout">
        <put-attribute name="body"  value="/WEB-INF/views/login.jsp" />
    </definition>
    <definition name="/loginSSO" extends="noLayout">
        <put-attribute name="body"  value="/WEB-INF/views/loginSSO.jsp" />
    </definition>
    <definition name="/loginAuth" extends="noLayout">
        <put-attribute name="body"  value="/WEB-INF/views/loginAuth.jsp" />
    </definition>

    <!-- error 관련 layout 적용 제외 -->
    <definition name="/error/*" extends="noLayout">
        <put-attribute name="body"  value="/WEB-INF/views/error/{1}.jsp" />
    </definition>

    <!-- 팝업 관련 -->
    <definition name="/*.popup" extends="popupLayout">
        <put-attribute name="body" value="/WEB-INF/views/{1}.jsp" />
    </definition>
    <definition name="/*/*.popup" extends="popupLayout">
        <put-attribute name="body" value="/WEB-INF/views/{1}/{2}.jsp" />
    </definition>

    <definition name="/*/*/*.popup" extends="popupLayout">
        <put-attribute name="body" value="/WEB-INF/views/{1}/{2}/{3}.jsp" />
    </definition>


    <!-- default -->
    <definition name="/emass/*" extends="defaultLayout">
        <put-attribute name="content" value="/WEB-INF/views/emass/{1}.jsp" />
    </definition>

    <definition name="/emass/*/*" extends="defaultLayout">
        <put-attribute name="content" value="/WEB-INF/views/emass/{1}/{2}.jsp" />
    </definition>

    <definition name="/commons/*" extends="defaultLayout">
        <put-attribute name="content" value="/WEB-INF/views/commons/{1}.jsp" />
    </definition>
    <definition name="/commons/*/*" extends="defaultLayout">
        <put-attribute name="content" value="/WEB-INF/views/commons/{1}/{2}.jsp" />
    </definition>

    <definition name="/uacs/*" extends="defaultLayout">
        <put-attribute name="content" value="/WEB-INF/views/uacs/{1}.jsp" />
    </definition>
    <definition name="/uacs/*/*" extends="defaultLayout">
        <put-attribute name="content" value="/WEB-INF/views/uacs/{1}/{2}.jsp" />
    </definition>

    <definition name="/analysis/*" extends="defaultLayout">
        <put-attribute name="content" value="/WEB-INF/views/analysis/{1}.jsp" />
    </definition>
    <definition name="/analysis/*/*" extends="defaultLayout">
        <put-attribute name="content" value="/WEB-INF/views/analysis/{1}/{2}.jsp" />
    </definition>


    <!-- emass message -->
    <definition name="/emass/message/messageNewN" extends="messageLayout">
        <put-attribute name="content" value="/WEB-INF/views/emass/message/messageNewN.jsp" />
    </definition>

    <definition name="/emass/message/msg/*" extends="defaultLayout">
        <put-attribute name="content" value="/WEB-INF/views/emass/message/msg/{1}.jsp" />
    </definition>

    <definition name="/emass/message/contentList" extends="noLayout">
        <put-attribute name="body" value="/WEB-INF/views/emass/message/contentList.jsp" />
    </definition>

    <definition name="/emass/message/contentBody" extends="noLayout">
        <put-attribute name="body" value="/WEB-INF/views/emass/message/contentBody.jsp" />
    </definition>

    <definition name="/emass/message/contentBodyNew" extends="noLayout">
        <put-attribute name="body" value="/WEB-INF/views/emass/message/contentBodyNew.jsp" />
    </definition>

    <!--###########################-->



</tiles-definitions>