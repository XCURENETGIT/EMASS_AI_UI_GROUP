dtDbDataSttValue OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-only
	STATUS      current
    DESCRIPTION "dtibuted databases data processing statistic value."
    ::= { dtDbDataSttEntry 4 }

