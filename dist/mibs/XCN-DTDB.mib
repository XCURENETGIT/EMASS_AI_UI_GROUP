    ::= { xcnDtibutedDB 4 }

clusterStaEntry OBJECT-TYPE
    SYNTAX      ClusterStaEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION "dtibuted databases cluster status entry."
