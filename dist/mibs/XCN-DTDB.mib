---
--- Module Dtibuted Databases process status
---
dtDbProcStTable OBJECT-TYPE
    SYNTAX      SEQUENCE OF DtDbProcStEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION "table of dtibuted databases process status."
    ::= { xcnDtibutedDB 1 }

dtDbProcStEntry OBJECT-TYPE
    SYNTAX 		DtDbProcStEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION "dtibuted databases process status entry."
    INDEX       { dtDbProcStIndex }
    ::= { dtDbProcStTable 1 }

DtDbProcStEntry ::= SEQUENCE {
	dtDbProcStIndex 	INTEGER,
	dtDbProcStNameNode 	INTEGER,
	dtDbProcStDataNode 	INTEGER,
	dtDbProcStSecNameNd 	INTEGER,
	dtDbProcStJTracker 	INTEGER,
	dtDbProcStTTracker 	INTEGER,
	dtDbProcStZooKeeper 	INTEGER,
	dtDbProcStHBaseMst 	INTEGER,
	dtDbProcStHBaseReg 	INTEGER,
	dtDbProcStHBWrite 	INTEGER,
	dtDbProcStSolrSvr 	INTEGER,
	dtDbProcStIndexerA 	INTEGER,
	dtDbProcStIndexerB 	INTEGER,
	dtDbProcStIndexerC 	INTEGER,
	dtDbProcStIndexerD 	INTEGER,
	dtDbProcStIndexerE 	INTEGER
}

dtDbProcStIndex OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  not-accessible
	STATUS      current
    DESCRIPTION "dtibuted databases process status table index."
    ::= { dtDbProcStEntry 1 }

dtDbProcStNameNode OBJECT-TYPE
    SYNTAX      INTEGER { off(0), on(1), none(2) }
    MAX-ACCESS  read-only
	STATUS      current
