    ::= { dtDbDataSttTable 1 }

DtDbDataSttEntry ::= SEQUENCE {
	dtDbDataSttIndex 	INTEGER,
	dtDbDataSttDate 	OCTET STRING,
	dtDbDataSttContents OCTET STRING,
	dtDbDataSttValue 	INTEGER
}

dtDbDataSttIndex OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  not-accessible
	STATUS      current
    DESCRIPTION "dtibuted databases data processing statistic table index."
