    ::= { clusterStaTable 1 }
    
ClusterStaEntry ::= SEQUENCE {
    clusterStaIndex     INTEGER,
    clusterStaKey       OCTET STRING,
    clusterStaValue     OCTET STRING,
    clusterStaLen       INTEGER
}

clusterStaIndex OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION "hadoop cluster status table index."
    ::= { clusterStaEntry 1 }

clusterStaKey OBJECT-TYPE
    SYNTAX      OCTET STRING
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "hadoop cluster status key field."
    ::= { clusterStaEntry 2 }
    
clusterStaValue OBJECT-TYPE
    SYNTAX      OCTET STRING
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "hadoop cluster status value field."
