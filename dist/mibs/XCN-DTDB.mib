---
--- Module Dtibuted Databases HDFS status
---
dtDbHdfsStTable OBJECT-TYPE
    SYNTAX      SEQUENCE OF DtDbHdfsStEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION "table of dtibuted databases HDFS status."
    ::= { xcnDtibutedDB 2 }

dtDbHdfsStEntry OBJECT-TYPE
    SYNTAX 		DtDbHdfsStEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION "dtibuted databases HDFS status entry."
    INDEX       { dtDbHdfsStIndex }
    ::= { dtDbHdfsStTable 1 }

DtDbHdfsStEntry ::= SEQUENCE {
	dtDbHdfsStIndex 	INTEGER,
	dtDbHdFsStTotal 	OCTET STRING,
	dtDbHdfsStCapacity 	OCTET STRING,
	dtDbHdfsStRemining 	OCTET STRING,
	dtDbHdfsStUsed 		OCTET STRING,
	dtDbHdfsStUsage 	INTEGER,
	dtDbHdfsStUndRepl 	INTEGER,
	dtDbHdfsStCorrupt 	INTEGER,
	dtDbHdfsStMissing 	INTEGER,
	dtDbHdfsNotifyLimit	INTEGER,
	dtDbHdfsDeleteLimit	INTEGER,
	dtDbHdfsSetLimit	INTEGER,
	dtDbHdfsWarnLimit	INTEGER,
	dtDbHdfsAlarmLimit	INTEGER
}

dtDbHdfsStIndex OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  not-accessible
	STATUS      current
    DESCRIPTION "dtibuted databases HDFS status table index."
    ::= { dtDbHdfsStEntry 1 }

dtDbHdFsStTotal OBJECT-TYPE
    SYNTAX      OCTET STRING
    MAX-ACCESS  read-only
	STATUS      current
    DESCRIPTION "dtibuted databases total storage size."
    ::= { dtDbHdfsStEntry 2 }

dtDbHdfsStCapacity OBJECT-TYPE
    SYNTAX      OCTET STRING
    MAX-ACCESS  read-only
	STATUS      current
    DESCRIPTION "dtibuted databases Present Capacity."
    ::= { dtDbHdfsStEntry 3 }

dtDbHdfsStRemining OBJECT-TYPE
    SYNTAX      OCTET STRING
    MAX-ACCESS  read-only
	STATUS      current
    DESCRIPTION "dtibuted databases HDFS Remaining."
    ::= { dtDbHdfsStEntry 4 }

dtDbHdfsStUsed OBJECT-TYPE
    SYNTAX      OCTET STRING
    MAX-ACCESS  read-only
	STATUS      current
    DESCRIPTION "dtibuted databases HDFS Used."
    ::= { dtDbHdfsStEntry 5 }

dtDbHdfsStUsage OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-only
	STATUS      current
    DESCRIPTION "dtibuted databases HDFS usage(00.00%)."
    ::= { dtDbHdfsStEntry 6 }

dtDbHdfsStUndRepl OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-only
	STATUS      current
    DESCRIPTION "dtibuted databases Under replicated blocks."
    ::= { dtDbHdfsStEntry 7 }

dtDbHdfsStCorrupt OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-only
	STATUS      current
    DESCRIPTION "dtibuted databases's blocks with corrupt replicas."
    ::= { dtDbHdfsStEntry 8 }

dtDbHdfsStMissing OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-only
	STATUS      current
    DESCRIPTION "dtibuted databases missing block."
    ::= { dtDbHdfsStEntry 9 }

dtDbHdfsNotifyLimit OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-write
	STATUS      current
    DESCRIPTION "dtibuted databases notification limit vale."
    ::= { dtDbHdfsStEntry 10 }

dtDbHdfsDeleteLimit OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-write
	STATUS      current
    DESCRIPTION "dtibuted databases clear limit vale."
    ::= { dtDbHdfsStEntry 11 }

dtDbHdfsSetLimit OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-write
	STATUS      current
    DESCRIPTION "dtibuted databases clear limit setting vale."
    ::= { dtDbHdfsStEntry 12 }

dtDbHdfsWarnLimit OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-write
	STATUS      current
    DESCRIPTION "dtibuted databases warning limit vale."
    ::= { dtDbHdfsStEntry 13 }

dtDbHdfsAlarmLimit OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-write
	STATUS      current
    DESCRIPTION "dtibuted databases alarm limit vale."
    ::= { dtDbHdfsStEntry 14 }

