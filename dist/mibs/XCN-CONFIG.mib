iifConfPoolSize OBJECT-TYPE
    SYNTAX      OCTET STRING
    MAX-ACCESS  read-only
	STATUS      current
    DESCRIPTION "IIF packet pool size"
    ::= { iifConfEntry 10 }

ipfRuleTable OBJECT-TYPE
    SYNTAX      SEQUENCE OF IpfRuleEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION "IP filtering rule information table."
    ::= { iifConfig 2 }

ipfRuleEntry OBJECT-TYPE
    SYNTAX      IpfRuleEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION "IP filtering rule information entry."
    INDEX       { ipfRuleIndex }
    ::= { ipfRuleTable 1 }

IpfRuleEntry ::= SEQUENCE {
	ipfRuleIndex 		INTEGER,
    ipfRuleVersion      INTEGER,
    ipfRuleSipFrom      OCTET STRING,
    ipfRuleSipTo        OCTET STRING,
    ipfRuleSportFrom    INTEGER,
    ipfRuleSportTo      INTEGER,
    ipfRuleDipFrom      OCTET STRING,
    ipfRuleDipTo        OCTET STRING,
    ipfRuleDportFrom    INTEGER,
    ipfRuleDportTo      INTEGER,
    ipfRuleProtocol     INTEGER,
    ipfRuleAction       INTEGER
}

ipfRuleIndex OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  not-accessible
	STATUS      current
    DESCRIPTION "IP filtering rule entry index."
    ::= { ipfRuleEntry 1 }

ipfRuleVersion  OBJECT-TYPE
    SYNTAX  INTEGER
    MAX-ACCESS  read-write
    STATUS  current
    DESCRIPTION "rule version"
    ::= { ipfRuleEntry 2 }

ipfRuleSipFrom  OBJECT-TYPE
    SYNTAX  OCTET STRING
    MAX-ACCESS  read-write
    STATUS  current
    DESCRIPTION "start source IP address"
    ::= { ipfRuleEntry 3 }

ipfRuleSipTo    OBJECT-TYPE
    SYNTAX  OCTET STRING
    MAX-ACCESS  read-write
    STATUS  current
    DESCRIPTION "end source IP address"
    ::= { ipfRuleEntry 4 }

ipfRuleSportFrom    OBJECT-TYPE
    SYNTAX  INTEGER
    MAX-ACCESS  read-write
    STATUS  current
    DESCRIPTION "start source port number"
    ::= { ipfRuleEntry 5 }

ipfRuleSportTo  OBJECT-TYPE
    SYNTAX  INTEGER
    MAX-ACCESS  read-write
    STATUS  current
    DESCRIPTION "end source port number"
    ::= { ipfRuleEntry 6 }
ipfRuleDipFrom  OBJECT-TYPE
    SYNTAX  OCTET STRING
    MAX-ACCESS  read-write
    STATUS  current
    DESCRIPTION "start destination IP address"
    ::= { ipfRuleEntry 7 }

ipfRuleDipTo    OBJECT-TYPE
    SYNTAX  OCTET STRING
    MAX-ACCESS  read-write
    STATUS  current
    DESCRIPTION "end destination IP address"
    ::= { ipfRuleEntry 8 }

ipfRuleDportFrom    OBJECT-TYPE
    SYNTAX  INTEGER
    MAX-ACCESS  read-write
    STATUS  current
    DESCRIPTION "start destination port number"
    ::= { ipfRuleEntry 9 }

ipfRuleDportTo  OBJECT-TYPE
    SYNTAX  INTEGER
    MAX-ACCESS  read-write
    STATUS  current
    DESCRIPTION "end destination port number"
    ::= { ipfRuleEntry 10 }

ipfRuleProtocol     OBJECT-TYPE
    SYNTAX  INTEGER { TCP(6), UDP(17) }
    MAX-ACCESS  read-write
    STATUS  current
    DESCRIPTION "protocol type setting (TCP:6, UDP:17)"
    ::= { ipfRuleEntry 11 }

ipfRuleAction   OBJECT-TYPE
    SYNTAX  INTEGER { log(1), nolog(2) }
    MAX-ACCESS  read-write
    STATUS  current
    DESCRIPTION "logging action setting (logging:1, no logging:2)"
    ::= { ipfRuleEntry 12 }

dhcpRuleTable OBJECT-TYPE
    SYNTAX      SEQUENCE OF DhcpRuleEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION "DHCP rule information table."
    ::= { iifConfig 3 }

dhcpRuleEntry OBJECT-TYPE
    SYNTAX      DhcpRuleEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION "DHCP rule information entry."
    INDEX       { dhcpRuleIndex }
    ::= { dhcpRuleTable 1 }

DhcpRuleEntry ::= SEQUENCE {
	dhcpRuleIndex 	INTEGER,
    dhcpRuleVer 	INTEGER,
    dhcpRuleMac 	OCTET STRING,
    dhcpRuleIp 		OCTET STRING
}

dhcpRuleIndex OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  not-accessible
	STATUS      current
    DESCRIPTION "DHCP rule entry index."
    ::= { dhcpRuleEntry 1 }

dhcpRuleVer  OBJECT-TYPE
    SYNTAX 		INTEGER
    MAX-ACCESS  read-write
    STATUS  current
    DESCRIPTION "DHCP rule version."
    ::= { dhcpRuleEntry 2 }

dhcpRuleMac  OBJECT-TYPE
    SYNTAX 		OCTET STRING
    MAX-ACCESS  read-write
    STATUS  current
    DESCRIPTION "DHCP MAC address."
    ::= { dhcpRuleEntry 3 }

dhcpRuleIp  OBJECT-TYPE
    SYNTAX 		OCTET STRING
    MAX-ACCESS  read-write
    STATUS  current
    DESCRIPTION "DHCP ip address."
    ::= { dhcpRuleEntry 4 }

QoSRuleTable OBJECT-TYPE
    SYNTAX      SEQUENCE OF QoSRuleEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION "QoS rule information table."
    ::= { iifConfig 4 }

qosRuleEntry OBJECT-TYPE
    SYNTAX      QoSRuleEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION "QoS rule information entry."
    INDEX       { qosRuleIndex }
    ::= { QoSRuleTable 1 }

QoSRuleEntry ::= SEQUENCE {
	qosRuleIndex 	INTEGER,
    qosSpeed 		INTEGER
}

qosRuleIndex OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  not-accessible
	STATUS      current
    DESCRIPTION "QoS rule entry index."
    ::= { qosRuleEntry 1 }

qosRuleSpeed OBJECT-TYPE
    SYNTAX 		INTEGER
    MAX-ACCESS  read-write
    STATUS  current
    DESCRIPTION "Tx Speed Limit."
    ::= { qosRuleEntry 2 }

END
