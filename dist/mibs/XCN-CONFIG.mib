XCN-CONFIG DEFINITIONS ::= BEGIN

IMPORTS
	OBJECT-TYPE 	FROM SNMPv2-SMI
	xcnMgmt 		FROM XCN-XCURENET;

xcnConfig MODULE-IDENTITY
   LAST-UPDATED "201305140000Z"
   ORGANIZATION "www.xcurenet.com"
   CONTACT-INFO "Postal    : XCURENET Co., Ltd.
                             9F DMC R&D Center, E3-2, DMC
                             Sangam-Dong Mapo-Gu
                             Seoul, 127-270, Korea
                 Telephone : 82-2-567-0961
                 FAX       : 82-2-567-0963
                 e-mail    : jhpark@xcurenet.com"
   DESCRIPTION  "Used by configuration information of XCURENET system."
   REVISION     "201305140000Z"
   DESCRIPTION  "First create by jpark"
   ::= { xcnMgmt 2 }

---
--- pgms configuration file information
---
pgmsConfig OBJECT IDENTIFIER ::= { xcnConfig 1 }

pgmsConfTable OBJECT-TYPE
    SYNTAX      SEQUENCE OF PgmsConfEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION "table of PGMS configuration file."
    ::= { pgmsConfig 1 }

pgmsConfEntry OBJECT-TYPE
    SYNTAX      PgmsConfEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION "pgms configuration entry."
    INDEX       { pgmsConfIndex }
    ::= { pgmsConfTable 1 }

PgmsConfEntry ::= SEQUENCE {
	pgmsConfIndex 		INTEGER,
	pgmsConfEid			INTEGER,
	pgmsConfDbIp 		OCTET STRING,
	pgmsConfType 		INTEGER,
	pgmsConfTdmUsed		INTEGER,
	pgmsConfVoipUsed 	INTEGER,
	pgmsConfDataUsed 	INTEGER,
	pgmsConfSneakUsed 	INTEGER,
	pgmsConfDtdbUsed 	INTEGER
}

pgmsConfIndex OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  not-accessible
	STATUS      current
    DESCRIPTION "pgms configuration table index."
    ::= { pgmsConfEntry 1 }

pgmsConfEid OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-write
	STATUS      current
    DESCRIPTION "pgms equipment ID."
    ::= { pgmsConfEntry 2 }

pgmsConfDbIp OBJECT-TYPE
    SYNTAX      OCTET STRING
    MAX-ACCESS  read-write
	STATUS      current
    DESCRIPTION "DB IP address"
    ::= { pgmsConfEntry 3 }

pgmsConfType OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-write
	STATUS      current
    DESCRIPTION "pgms equipment type."
    ::= { pgmsConfEntry 4 }

pgmsConfTdmUsed OBJECT-TYPE
    SYNTAX      INTEGER { off(0), on(1) }
    MAX-ACCESS  read-write
	STATUS      current
    DESCRIPTION "TDM features used."
    ::= { pgmsConfEntry 5 }

pgmsConfVoipUsed OBJECT-TYPE
    SYNTAX      INTEGER { off(0), on(1) }
    MAX-ACCESS  read-write
	STATUS      current
    DESCRIPTION "VoIP features used."
    ::= { pgmsConfEntry 6 }

pgmsConfDataUsed OBJECT-TYPE
    SYNTAX      INTEGER { off(0), on(1) }
    MAX-ACCESS  read-write
	STATUS      current
    DESCRIPTION "EMASS module used."
    ::= { pgmsConfEntry 7 }

pgmsConfSneakUsed OBJECT-TYPE
    SYNTAX      INTEGER { off(0), on(1) }
    MAX-ACCESS  read-write
	STATUS      current
    DESCRIPTION "SNEAK module used."
    ::= { pgmsConfEntry 8 }

pgmsConfDtdbUsed OBJECT-TYPE
    SYNTAX      INTEGER { off(0), on(1) }
    MAX-ACCESS  read-only
	STATUS      current
    DESCRIPTION "Distributed DB used."
    ::= { pgmsConfEntry 9 }

tellusConfTable OBJECT-TYPE
    SYNTAX      SEQUENCE OF TellusConfEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION "table of TELLUS configuration file."
    ::= { pgmsConfig 2 }

tellusConfEntry OBJECT-TYPE
    SYNTAX      TellusConfEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION "tellus configuration entry."
    INDEX       { tellusConfIndex }
    ::= { tellusConfTable 1 }

TellusConfEntry ::= SEQUENCE {
	tellusConfIndex 	INTEGER,
	tellusConfDomain	INTEGER,
	tellusConfCardNo	INTEGER,
	tellusConfCpuNo		INTEGER
}

tellusConfIndex OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  not-accessible
	STATUS      current
    DESCRIPTION "tellus configuration table index."
    ::= { tellusConfEntry 1 }

tellusConfDomain OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-only
	STATUS      current
    DESCRIPTION "tellus domain number"
    ::= { tellusConfEntry 2 }

tellusConfCardNo OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-only
	STATUS      current
    DESCRIPTION "tellus card number"
    ::= { tellusConfEntry 3 }

tellusConfCpuNo OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-only
	STATUS      current
    DESCRIPTION "tellus CPU number"
    ::= { tellusConfEntry 4 }

---
--- TDM board configuration file information
---
tdmConfig OBJECT IDENTIFIER ::= { xcnConfig 2 }

tdmBdConfTable OBJECT-TYPE
    SYNTAX      SEQUENCE OF TdmBdConfEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION "table of TDM board configuration file."
    ::= { tdmConfig 1 }

tdmBdConfEntry OBJECT-TYPE
    SYNTAX      TdmBdConfEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION "TDM board configuration entry."
    INDEX       { tdmBdConfIndex }
    ::= { tdmBdConfTable 1 }

TdmBdConfEntry ::= SEQUENCE {
	tdmBdConfIndex 		INTEGER,
	tdmBdConfTotalBd	INTEGER,
	tdmBdConfTotalCh	INTEGER,
	tdmBdConfEvtIfType 	INTEGER,
	tdmBdConfApiLog		INTEGER
}

tdmBdConfIndex OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  not-accessible
	STATUS      current
    DESCRIPTION "TDM board configuration table index."
    ::= { tdmBdConfEntry 1 }

tdmBdConfTotalBd OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-only
	STATUS      current
    DESCRIPTION "total number of TDM board."
    ::= { tdmBdConfEntry 2 }

tdmBdConfTotalCh OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-only
	STATUS      current
    DESCRIPTION "total number of channel."
    ::= { tdmBdConfEntry 3 }

tdmBdConfEvtIfType OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-only
	STATUS      current
    DESCRIPTION "TDM board's event interface type"
    ::= { tdmBdConfEntry 4 }

tdmBdConfApiLog OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-only
	STATUS      current
    DESCRIPTION "TDM board's API log enable"
    ::= { tdmBdConfEntry 5 }

---
--- One of TDM board attribute
---
tdmBdAttrTable OBJECT-TYPE
    SYNTAX      SEQUENCE OF TdmBdAttrEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION "one of TDM board attribute table."
    ::= { tdmConfig 2 }

tdmBdAttrEntry OBJECT-TYPE
    SYNTAX      TdmBdAttrEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION "TDM board attribute entry."
    INDEX       { tdmBdAttrIndex }
    ::= { tdmBdAttrTable 1 }

TdmBdAttrEntry ::= SEQUENCE {
	tdmBdAttrIndex 		INTEGER,
	tdmBdAttrBdNo		INTEGER,
	tdmBdAttrChannel	INTEGER,
	tdmBdAttrStartCh	INTEGER,
	tdmBdAttrEndCh		INTEGER,
	tdmBdAttrModel		OCTET STRING,
	tdmBdAttrSerial 	OCTET STRING,
	tdmBdAttrPbx	 	OCTET STRING,
	tdmBdAttrDefVform	INTEGER
}

tdmBdAttrIndex OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  not-accessible
	STATUS      current
    DESCRIPTION "TDM board attribute table index."
    ::= { tdmBdAttrEntry 1 }

tdmBdAttrBdNo OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-only
	STATUS      current
    DESCRIPTION "board index number."
    ::= { tdmBdAttrEntry 2 }

tdmBdAttrChannel OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-only
	STATUS      current
    DESCRIPTION "total number of one board."
    ::= { tdmBdAttrEntry 3 }

tdmBdAttrStartCh OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-only
	STATUS      current
    DESCRIPTION "start channel of board."
    ::= { tdmBdAttrEntry 4 }

tdmBdAttrEndCh OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-only
	STATUS      current
    DESCRIPTION "end channel of board."
    ::= { tdmBdAttrEntry 5 }

tdmBdAttrModel OBJECT-TYPE
    SYNTAX      OCTET STRING
    MAX-ACCESS  read-only
	STATUS      current
    DESCRIPTION "TDM board's model."
    ::= { tdmBdAttrEntry 6 }

tdmBdAttrSerial OBJECT-TYPE
    SYNTAX      OCTET STRING
    MAX-ACCESS  read-only
	STATUS      current
    DESCRIPTION "TDM board's serial number."
    ::= { tdmBdAttrEntry 7 }

tdmBdAttrPbx OBJECT-TYPE
    SYNTAX      OCTET STRING
    MAX-ACCESS  read-only
	STATUS      current
    DESCRIPTION "TDM board's PBX type."
    ::= { tdmBdAttrEntry 8 }

tdmBdAttrDefVform OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-only
	STATUS      current
    DESCRIPTION "TDM board's default voice format."
    ::= { tdmBdAttrEntry 9 }

---
--- TDM Channel information
---
tdmChInfoTable OBJECT-TYPE
    SYNTAX      SEQUENCE OF TdmChInfoEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION "TDM channel information table."
    ::= { tdmConfig 3 }

tdmChInfoEntry OBJECT-TYPE
    SYNTAX      TdmChInfoEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION "TDM channel information entry."
    INDEX       { tdmChInfoIndex }
    ::= { tdmChInfoTable 1 }

TdmChInfoEntry ::= SEQUENCE {
	tdmChInfoIndex 		INTEGER,
	tdmChInfoBdNo		INTEGER,
	tdmChInfoPhyscNo	INTEGER,
	tdmChInfoLogicNo	INTEGER,
	tdmChInfoType		OCTET STRING,
	tdmChInfoRegist		INTEGER,
	tdmChInfoRecVol		INTEGER,
	tdmChInfoMode		OCTET STRING,
	tdmChInfoEcho		INTEGER,
	tdmChInfoAgc		INTEGER,
	tdmChInfoLvt		INTEGER,
	tdmChInfoVolRef		OCTET STRING,
	tdmChInfoIgnoreLvt 	INTEGER,
	tdmChInfoBargeSens 	INTEGER
}

tdmChInfoIndex OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  not-accessible
	STATUS      current
    DESCRIPTION "TDM channel index."
    ::= { tdmChInfoEntry 1 }

tdmChInfoBdNo OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-only
	STATUS      current
    DESCRIPTION "board index number."
    ::= { tdmChInfoEntry 2 }

tdmChInfoPhyscNo OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-only
	STATUS      current
    DESCRIPTION "Physical channel number."
    ::= { tdmChInfoEntry 3 }

tdmChInfoLogicNo OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-only
	STATUS      current
    DESCRIPTION "Logical channel number."
    ::= { tdmChInfoEntry 4 }

tdmChInfoType OBJECT-TYPE
    SYNTAX      OCTET STRING
    MAX-ACCESS  read-only
	STATUS      current
    DESCRIPTION "channel type"
    ::= { tdmChInfoEntry 5 }

tdmChInfoRegist OBJECT-TYPE
    SYNTAX      INTEGER { unregister(0), register(1) }
    MAX-ACCESS  read-only
	STATUS      current
    DESCRIPTION "channel's register information."
    ::= { tdmChInfoEntry 6 }

tdmChInfoRecVol OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-only
	STATUS      current
    DESCRIPTION "record volume"
    ::= { tdmChInfoEntry 7 }

tdmChInfoMode OBJECT-TYPE
    SYNTAX      OCTET STRING
    MAX-ACCESS  read-only
	STATUS      current
    DESCRIPTION "recording mode"
    ::= { tdmChInfoEntry 8 }

tdmChInfoEcho OBJECT-TYPE
    SYNTAX      INTEGER { off(0), on(1) }
    MAX-ACCESS  read-only
	STATUS      current
    DESCRIPTION "echocanceler used."
    ::= { tdmChInfoEntry 9 }

tdmChInfoAgc OBJECT-TYPE
    SYNTAX      INTEGER { off(0), on(1) }
    MAX-ACCESS  read-only
	STATUS      current
    DESCRIPTION "automatic gain control used"
    ::= { tdmChInfoEntry 10 }

tdmChInfoLvt OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-only
	STATUS      current
    DESCRIPTION "line voltage threshold value"
    ::= { tdmChInfoEntry 11 }

tdmChInfoVolRef OBJECT-TYPE
    SYNTAX      OCTET STRING
    MAX-ACCESS  read-only
	STATUS      current
    DESCRIPTION "channel's voltageReference value"
    ::= { tdmChInfoEntry 12 }

tdmChInfoIgnoreLvt OBJECT-TYPE
    SYNTAX      INTEGER { off(0), on(1) }
    MAX-ACCESS  read-only
	STATUS      current
    DESCRIPTION "Ignore Line voltage used"
    ::= { tdmChInfoEntry 13 }

tdmChInfoBargeSens OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-only
	STATUS      current
    DESCRIPTION "BargedIn sensetive value"
    ::= { tdmChInfoEntry 14 }

