iifConfig OBJECT IDENTIFIER ::= { xcnConfig 6 }

iifConfTable OBJECT-TYPE
    SYNTAX      SEQUENCE OF IifConfEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION "IIF configuration information table."
