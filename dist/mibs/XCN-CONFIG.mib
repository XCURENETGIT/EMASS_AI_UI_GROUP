EmassConfEntry ::= SEQUENCE {
	emassConfIndex 	INTEGER,
	emassConfTlsIp 	OCTET STRING,
	emassConfWrtIp 	OCTET STRING,
	emassConfAppIp 	OCTET STRING
}

