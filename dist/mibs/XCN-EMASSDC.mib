emdcIpfV6RuleProtocol 	OBJECT-TYPE
	SYNTAX	INTEGER { TCP(6), UDP(17) }
	MAX-ACCESS	read-write
	STATUS	current
	DESCRIPTION	"protocol type setting (TCP:6, UDP:17)"
	::= { emdcIpfV6RuleEntry 11 }

emdcIpfV6RuleAction 	OBJECT-TYPE
