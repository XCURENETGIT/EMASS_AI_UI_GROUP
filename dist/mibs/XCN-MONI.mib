procCfProcName OBJECT-TYPE
    SYNTAX      OCTET STRING
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "process name of group"
    ::= { procCfEntry 3 } 

procCfProcStime OBJECT-TYPE
    SYNTAX      OCTET STRING
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "loading time of process"
    ::= { procCfEntry 4 } 

procCfProcCnt OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "number of process to be loaded"
    ::= { procCfEntry 5 } 

procCfProcRun OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "number of process currently running"
    ::= { procCfEntry 6 } 

procCfStatus OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "process status : 0(Normal), 1(Abnormal), 2(unused)"
    ::= { procCfEntry 7 } 

procCfCommand OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-write
    STATUS      current
    DESCRIPTION "stop or start process : 0(default : non-action), 1(stop), 2(restart)"
    ::= { procCfEntry 8 } 

procCfVersion OBJECT-TYPE
    SYNTAX      OCTET STRING
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "process version"
    ::= { procCfEntry 9 } 

