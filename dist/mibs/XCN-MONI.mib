--- service group 
---
svcGroupTable OBJECT-TYPE
    SYNTAX      SEQUENCE OF SvcGroupEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION "table of service group."
    ::= { xcnMonitor 13 } 

svcGroupEntry OBJECT-TYPE
    SYNTAX      SvcGroupEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION "service group entry."
    INDEX       { svcGroupIndex }
    ::= { svcGroupTable 1 } 

SvcGroupEntry ::= SEQUENCE {
    svcGroupIndex		INTEGER,
	svcGroupNodeType	INTEGER,
	svcGroupName		OCTET STRING,
	svcGroupProcName	OCTET STRING,
	svcGroupProcStime	OCTET STRING,
	svcGroupProcCnt		INTEGER,
	svcGroupProcRun		INTEGER,
	svcGroupStatus		INTEGER,
	svcGroupCommand		INTEGER

}

svcGroupIndex OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION "service group list entry index."
    ::= { svcGroupEntry 1 } 

svcGroupNodeType OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "node type : 0(old Tellus 수집), 1(예하부 DB서버), 10(pgms Tellus 수집), 11(사령부 DB서버)"
    ::= { svcGroupEntry 2 } 

svcGroupName OBJECT-TYPE
    SYNTAX      OCTET STRING
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "service group name"
    ::= { svcGroupEntry 3 } 

svcGroupProcName OBJECT-TYPE
    SYNTAX      OCTET STRING
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "representative process name of service group"
    ::= { svcGroupEntry 4 } 

svcGroupProcStime OBJECT-TYPE
    SYNTAX      OCTET STRING
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "loading time of representative process"
    ::= { svcGroupEntry 5 } 

svcGroupProcCnt OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "number of representative process to be loaded"
    ::= { svcGroupEntry 6 } 

svcGroupProcRun OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "number of representative process currently running"
    ::= { svcGroupEntry 7 } 

svcGroupStatus OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "service group status based on representative process status : 0(Normal), 1(Abnormal - loss of process), 2(Abnormal process)"
    ::= { svcGroupEntry 8 } 

svcGroupCommand OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-write
    STATUS      current
    DESCRIPTION "stop or start service group : 0(default : non-action), 1(stop), 2(restart)"
    ::= { svcGroupEntry 9 } 



