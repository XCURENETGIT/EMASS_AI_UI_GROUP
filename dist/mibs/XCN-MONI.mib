    ::= { statEDCEntry 11 } 
	
	
---
--- new emass proc
---
procEmassTable OBJECT-TYPE
    SYNTAX      SEQUENCE OF ProcEmassEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION "table of new emass process."
    ::= { xcnMonitor 17 } 

procEmassEntry OBJECT-TYPE
    SYNTAX      ProcEmassEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION "new emass process entry."
    INDEX       { procEmassIndex }
    ::= { procEmassTable 1 } 

ProcEmassEntry ::= SEQUENCE {
    procEmassIndex			INTEGER,
	procEmassGroupName		OCTET STRING,
	procEmassProcName		OCTET STRING,
	procEmassProcStime		OCTET STRING,
	procEmassProcCnt		INTEGER,
	procEmassProcRun		INTEGER,
	procEmasspStatus		INTEGER,
	procEmassCommand		INTEGER,
	procEmassVersion		OCTET STRING

}

procEmassIndex OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION "process list entry index."
    ::= { procEmassEntry 1 } 
	
procEmassGroupName OBJECT-TYPE
    SYNTAX      OCTET STRING
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "process group name"
    ::= { procEmassEntry 2 } 

procEmassProcName OBJECT-TYPE
    SYNTAX      OCTET STRING
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "process name of group"
    ::= { procEmassEntry 3 } 

procEmassProcStime OBJECT-TYPE
    SYNTAX      OCTET STRING
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "loading time of process"
    ::= { procEmassEntry 4 } 

procEmassProcCnt OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "number of process to be loaded"
    ::= { procEmassEntry 5 } 

procEmassProcRun OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "number of process currently running"
    ::= { procEmassEntry 6 } 

procEmassStatus OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "process status : 0(Normal), 1(Abnormal), 2(unused)"
    ::= { procEmassEntry 7 } 

procEmassCommand OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-write
    STATUS      current
    DESCRIPTION "stop or start process : 0(default : non-action), 1(stop), 2(restart)"
    ::= { procEmassEntry 8 } 

procEmassVersion OBJECT-TYPE
    SYNTAX      OCTET STRING
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "process version"
    ::= { procEmassEntry 9 } 

---
--- integrity proc
---
integrityTable OBJECT-TYPE
    SYNTAX      SEQUENCE OF IntegrityEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION "table of new emass process."
    ::= { xcnMonitor 18 } 

integrityEntry OBJECT-TYPE
    SYNTAX      IntegrityEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION "integrity check entry."
    INDEX       { integrityIndex }
    ::= { integrityTable 1 } 

IntegrityEntry ::= SEQUENCE {
    	integrityIndex		INTEGER,
	integrityCF		INTEGER,
	integrityEmassLT	INTEGER
}

integrityIndex OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION "integrity entry index."
    ::= { integrityEntry 1 } 
	
integrityCF OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-write
    STATUS      current
    DESCRIPTION "integrity CF check : 0(default : non-action), 1(start)"
    ::= { integrityEntry 2 } 

integrityEmassLT OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-write
    STATUS      current
    DESCRIPTION "integrity EmassLT check : 0(default : non-action), 1(start)"
    ::= { integrityEntry 3 } 

---
