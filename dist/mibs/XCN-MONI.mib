iifTrafficPort OBJECT-TYPE
    SYNTAX      OCTET STRING
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "iif mirroring port name."
    ::= { iifTrafficEntry 2 } 

iifTrafficDirection OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "iif mirroring traffic direction : 0(inbound or Rx), 1(outbound or Tx)."
