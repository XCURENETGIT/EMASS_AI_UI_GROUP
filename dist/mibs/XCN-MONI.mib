XCN-MONI DEFINITIONS ::= BEGIN

IMPORTS
	OBJECT-TYPE 	FROM SNMPv2-SMI
	xcnMgmt 		FROM XCN-XCURENET;

xcnMonitor MODULE-IDENTITY
   LAST-UPDATED "201604040000Z"
   ORGANIZATION "www.xcurenet.com"
   CONTACT-INFO "Postal    : XCURENET Co., Ltd.
                             9F DMC R&D Center, E3-2, DMC
                             Sangam-Dong Mapo-Gu
                             Seoul, 127-270, Korea
                 Telephone : 82-2-567-0961
                 FAX       : 82-2-567-0963
                 e-mail    : choish@xcurenet.com"
   DESCRIPTION  "For system monitoring private MIBs."
   REVISION     "201207170000Z"
   DESCRIPTION  "First create by jpark"
   ::= { xcnMgmt 1 }

---
--- Module Version information
---
versionTable OBJECT-TYPE
    SYNTAX      SEQUENCE OF VersionEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION "table of each module version."
    ::= { xcnMonitor 1 }

versionEntry OBJECT-TYPE
    SYNTAX      VersionEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION " version informatin entry."
    INDEX       { verIndex }
    ::= { versionTable 1 }

VersionEntry ::= SEQUENCE {
	verIndex	INTEGER,
	verTellus	OCTET STRING,
	verEmass	OCTET STRING,
	verSynwayDM	OCTET STRING,
	verSnmpa	OCTET STRING,
	verSneak	OCTET STRING
}

verIndex OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  not-accessible
	STATUS      current
    DESCRIPTION "version table index."
    ::= { versionEntry 1 }

verTellus OBJECT-TYPE
    SYNTAX      OCTET STRING
    MAX-ACCESS  read-only
	STATUS      current
    DESCRIPTION "display TELLUS package version."
    ::= { versionEntry 2 }

verEmass OBJECT-TYPE
    SYNTAX      OCTET STRING
    MAX-ACCESS  read-only
	STATUS      current
    DESCRIPTION "display EMASS package version."
    ::= { versionEntry 3 }

verSynwayDM OBJECT-TYPE
    SYNTAX      OCTET STRING
    MAX-ACCESS  read-only
	STATUS      current
    DESCRIPTION "display Synway Driver Module version."
    ::= { versionEntry 4 }

verSnmpa OBJECT-TYPE
    SYNTAX      OCTET STRING
    MAX-ACCESS  read-only
	STATUS      current
    DESCRIPTION "display SNMP Agent package version."
    ::= { versionEntry 5 }

verSneak OBJECT-TYPE
    SYNTAX      OCTET STRING
    MAX-ACCESS  read-only
	STATUS      current
    DESCRIPTION "display SNEAK package version."
    ::= { versionEntry 6 }

---
--- system information
---
sysInfoTable OBJECT-TYPE
    SYNTAX      SEQUENCE OF SysInfoEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION "table of system information."
    ::= { xcnMonitor 2 }

sysInfoEntry OBJECT-TYPE
    SYNTAX      SysInfoEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION " system informatin entry."
    INDEX       { sysInfoIndex }
    ::= { sysInfoTable 1 }

SysInfoEntry ::= SEQUENCE {
	sysInfoIndex	INTEGER,
	sysInfoUserId	INTEGER,
	sysInfoIpAddr	OCTET STRING,
	sysInfoAgentX	INTEGER,
	sysInfoContact	OCTET STRING,
	sysInfoUptime	OCTET STRING,
	sysInfoDate		OCTET STRING,
	sysInfoConfigInitCount	INTEGER,
	sysInfoStatusNotiForD2	INTEGER,
	sysInfoStatusWarnForD2	INTEGER,
	sysInfoStatusAlarmForD2	INTEGER,
	sysInfoStatusForD2	INTEGER,
	sysInfoStatusNotiHdd	OCTET STRING,
	sysInfoStatusWarnHdd	OCTET STRING,
	sysInfoStatusAlarmHdd	OCTET STRING,
	sysInfoStatusAlarmLink	OCTET STRING,
	sysInfoStatusAlarmProc	OCTET STRING,
	sysInfoStatusNotiIif	OCTET STRING,
	sysInfoStatusWarnIif	OCTET STRING,
	sysInfoStatusAlarmIif	OCTET STRING,
	sysInfoStatusNotiTrans	OCTET STRING,
	sysInfoStatusWarnTrans	OCTET STRING,
	sysInfoStatusAlarmTrans	OCTET STRING,
	sysInfoStatusRedun	INTEGER,
	sysInfoHostname		OCTET STRING
}

sysInfoIndex OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  not-accessible
	STATUS      current
    DESCRIPTION "system information table index."
    ::= { sysInfoEntry 1 }

sysInfoUserId OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-only
	STATUS      current
    DESCRIPTION "userID information."
    ::= { sysInfoEntry 2 }

sysInfoIpAddr OBJECT-TYPE
    SYNTAX      OCTET STRING  (SIZE(0..15))
    MAX-ACCESS  read-only
	STATUS      current
    DESCRIPTION "system IP address"
    ::= { sysInfoEntry 3 }

sysInfoAgentX OBJECT-TYPE
    SYNTAX      INTEGER { off(0), on(1) }
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "master agent used"
    ::= { sysInfoEntry 4 }

sysInfoContact OBJECT-TYPE
    SYNTAX      OCTET STRING
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "system contact."
    ::= { sysInfoEntry 5 }

sysInfoUptime OBJECT-TYPE
    SYNTAX      OCTET STRING
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "system uptime information."
    ::= { sysInfoEntry 6 }

sysInfoDate OBJECT-TYPE
    SYNTAX      OCTET STRING
    MAX-ACCESS  read-write
    STATUS      current
    DESCRIPTION "system date information."
    ::= { sysInfoEntry 7 }

sysInfoConfigInitCount OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-write
    STATUS      current
    DESCRIPTION "System Configuration Initialization Count"
    ::= { sysInfoEntry 8 }

sysInfoStatusNotiForD2 OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "System Status Notify : concerning level"
    ::= { sysInfoEntry 9 }

sysInfoStatusWarnForD2 OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "System Status Warn : warning level"
    ::= { sysInfoEntry 10 }

sysInfoStatusAlarmForD2 OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "System Status Alarm : risky level"
    ::= { sysInfoEntry 11 }

sysInfoStatusForD2 OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "System Status : 0(Normal), 1(Notify), 2(Warn), 3(Alarm)"
    ::= { sysInfoEntry 12 }

sysInfoStatusNotiHdd OBJECT-TYPE
    SYNTAX      OCTET STRING
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "List of HDD notify status."
    ::= { sysInfoEntry 13 }

sysInfoStatusWarnHdd OBJECT-TYPE
    SYNTAX      OCTET STRING
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "List of HDD warning status."
    ::= { sysInfoEntry 14 }

sysInfoStatusAlarmHdd OBJECT-TYPE
    SYNTAX      OCTET STRING
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "List of HDD alarm status."
    ::= { sysInfoEntry 15 }

sysInfoStatusAlarmLink OBJECT-TYPE
    SYNTAX      OCTET STRING
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "List of Link down status."
    ::= { sysInfoEntry 16 }

sysInfoStatusAlarmProc OBJECT-TYPE
    SYNTAX      OCTET STRING
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "List of proc down status."
    ::= { sysInfoEntry 17 }

sysInfoStatusNotiIif OBJECT-TYPE
    SYNTAX      OCTET STRING
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "List of iif noti status."
    ::= { sysInfoEntry 18 }

sysInfoStatusWarnIif OBJECT-TYPE
    SYNTAX      OCTET STRING
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "List of iif warn status."
    ::= { sysInfoEntry 19 }

sysInfoStatusAlarmIif OBJECT-TYPE
    SYNTAX      OCTET STRING
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "List of iif alarm status."
    ::= { sysInfoEntry 20 }

sysInfoStatusNotiTrans OBJECT-TYPE
    SYNTAX      OCTET STRING
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "List of transmit noti status."
    ::= { sysInfoEntry 21 }

sysInfoStatusWarnTrans OBJECT-TYPE
    SYNTAX      OCTET STRING
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "List of transmit warn status."
    ::= { sysInfoEntry 22 }

sysInfoStatusAlarmTrans OBJECT-TYPE
    SYNTAX      OCTET STRING
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "List of transmit alarm status."
    ::= { sysInfoEntry 23 }

sysInfoStatusRedun OBJECT-TYPE
    SYNTAX      INTEGER { Standby(0), Active(1) }
    MAX-ACCESS  read-write
    STATUS      current
    DESCRIPTION "System Redundancy Status"
    ::= { sysInfoEntry 24 }

sysInfoHostname OBJECT-TYPE
    SYNTAX      OCTET STRING
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "system hostname."
    ::= { sysInfoEntry 25 }

---
--- CPU information
---
cpuInfoTable OBJECT-TYPE
    SYNTAX      SEQUENCE OF CpuInfoEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION "table of CPU information."
    ::= { xcnMonitor 3 }

cpuInfoEntry OBJECT-TYPE
    SYNTAX      CpuInfoEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION "CPU informatin entry."
    INDEX       { cpuInfoIndex }
    ::= { cpuInfoTable 1 }

CpuInfoEntry ::= SEQUENCE {
	cpuInfoIndex		INTEGER,
	cpuInfoVendor		OCTET STRING,
	cpuInfoModel		OCTET STRING,
	cpuInfoSpeed		INTEGER,
	cpuInfoCoreNumber	INTEGER,
	cpuInfoClockSource	INTEGER
}

cpuInfoIndex OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  not-accessible
	STATUS      current
    DESCRIPTION "CPU information table index."
    ::= { cpuInfoEntry 1 }

cpuInfoVendor OBJECT-TYPE
    SYNTAX      OCTET STRING
    MAX-ACCESS  read-only
	STATUS      current
    DESCRIPTION "CPU vendor information."
    ::= { cpuInfoEntry 2 }

cpuInfoModel OBJECT-TYPE
    SYNTAX      OCTET STRING
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "CPU model information."
    ::= { cpuInfoEntry 3 }

cpuInfoSpeed OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "CPU speed(Mhz) information."
    ::= { cpuInfoEntry 4 }

cpuInfoCoreNumber OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "CPU core number."
    ::= { cpuInfoEntry 5 }

cpuInfoClockSource OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "system clock source."
    ::= { cpuInfoEntry 6 }

---
--- CPU load
---
cpuLoadTable OBJECT-TYPE
    SYNTAX      SEQUENCE OF CpuLoadEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION "table of CPU load information."
    ::= { xcnMonitor 4 }

cpuLoadEntry OBJECT-TYPE
    SYNTAX      CpuLoadEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION "CPU load entry."
    INDEX       { cpuLoadIndex }
    ::= { cpuLoadTable 1 }

CpuLoadEntry ::= SEQUENCE {
	cpuLoadIndex	INTEGER,
	cpuLoadCpuName	OCTET STRING,
	cpuLoadUser		INTEGER,
	cpuLoadSystem	INTEGER,
	cpuLoadNice		INTEGER,
	cpuLoadIdle		INTEGER,
	cpuLoadWait		INTEGER,
	cpuLoadHi		INTEGER,
	cpuLoadSi		INTEGER,
	cpuLoadUsage	INTEGER,
	cpuLoadLimit	INTEGER
}

cpuLoadIndex OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION "CPU load entry index."
    ::= { cpuLoadEntry 1 }

cpuLoadCpuName OBJECT-TYPE
    SYNTAX      OCTET STRING
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "CPU name."
    ::= { cpuLoadEntry 2 }

cpuLoadUser OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "CPU usage in user level"
    ::= { cpuLoadEntry 3 }

cpuLoadSystem OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "CPU usage in system level"
    ::= { cpuLoadEntry 4 }

cpuLoadNice OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "CPU usage in nice level"
    ::= { cpuLoadEntry 5 }

cpuLoadIdle OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "CPU usage in idle state"
    ::= { cpuLoadEntry 6 }

cpuLoadWait OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "CPU I/O wait"
    ::= { cpuLoadEntry 7 }

cpuLoadHi OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "H/W interrupt request"
    ::= { cpuLoadEntry 8 }

cpuLoadSi OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "S/W interrupt request"
    ::= { cpuLoadEntry 9 }

cpuLoadUsage OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "CPU usage"
    ::= { cpuLoadEntry 10 }

cpuLoadLimit OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-write
    STATUS      current
    DESCRIPTION "CPU usage limit threshold"
    ::= { cpuLoadEntry 11 }

---
--- memory information
---
memInfoTable OBJECT-TYPE
    SYNTAX      SEQUENCE OF MemInfoEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION "system memory information."
    ::= { xcnMonitor 5 }

memInfoEntry OBJECT-TYPE
    SYNTAX      MemInfoEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION "system memory entry."
    INDEX       { memInfoIndex }
    ::= { memInfoTable 1 }

MemInfoEntry ::= SEQUENCE {
	memInfoIndex	INTEGER,
	memInfoTotal	INTEGER,
	memInfoUsed	INTEGER,
	memInfoFree	INTEGER,
	memInfoShared	INTEGER,
	memInfoBuff	INTEGER,
	memInfoCach	INTEGER,
	memInfoUsage	INTEGER,
	memInfoLimit	INTEGER,
	memInfoSlab	INTEGER
}

memInfoIndex OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION "memory information entry index."
    ::= { memInfoEntry 1 }

memInfoTotal OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "memory total size"
    ::= { memInfoEntry 2 }

memInfoUsed OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "memory total amount"
    ::= { memInfoEntry 3 }

memInfoFree OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "memory free amount"
    ::= { memInfoEntry 4 }

memInfoShared OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "memory shared range"
    ::= { memInfoEntry 5 }

memInfoBuff OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "memory buffers range"
    ::= { memInfoEntry 6 }

memInfoCach OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "memory cached range"
    ::= { memInfoEntry 7 }

memInfoUsage OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "memory usage"
    ::= { memInfoEntry 8 }

memInfoLimit OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-write
    STATUS      current
    DESCRIPTION "memory usage limit threshold"
    ::= { memInfoEntry 9 }

memInfoSlab OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "memory slab range"
    ::= { memInfoEntry 10 }

---
--- Hard Disk Driver
---
hddInfoTable OBJECT-TYPE
    SYNTAX      SEQUENCE OF HddInfoEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION "hard disk driver information table."
    ::= { xcnMonitor 6 }

hddInfoEntry OBJECT-TYPE
    SYNTAX      HddInfoEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION "hard disk driver information entry"
    INDEX       { hddInfoIndex }
    ::= { hddInfoTable 1 }

HddInfoEntry ::= SEQUENCE {
	hddInfoIndex		INTEGER,
	hddInfoDevName		OCTET STRING,
	hddInfoMountDir		OCTET STRING,
	hddInfoBlocks		INTEGER,
	hddInfoAvail		INTEGER,
	hddInfoUsed			INTEGER,
	hddInfoUsage		INTEGER,
	hddNotifyLimit		INTEGER,
	hddDeleteLimit		INTEGER,
	hddSetLimit		    INTEGER,
	hddWarnLimit        INTEGER,
	hddAlarmLimit       INTEGER
}

hddInfoIndex OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION "hard disk driver entry index."
    ::= { hddInfoEntry 1 }

hddInfoDevName OBJECT-TYPE
    SYNTAX      OCTET STRING
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "hard disk driver's device name"
    ::= { hddInfoEntry 2 }

hddInfoMountDir OBJECT-TYPE
    SYNTAX      OCTET STRING
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "hard disk driver's mount directory"
    ::= { hddInfoEntry 3 }

hddInfoBlocks OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "hard disk driver's block size (MB)"
    ::= { hddInfoEntry 4 }

hddInfoAvail OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "hard disk driver's avail size (MB)"
    ::= { hddInfoEntry 5 }

hddInfoUsed OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "hard disk driver's use of size (MB)"
    ::= { hddInfoEntry 6 }

hddInfoUsage OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "hard disk driver's usage"
    ::= { hddInfoEntry 7 }

hddNotifyLimit OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-write
    STATUS      current
    DESCRIPTION "hard disk driver's usage notify limit threshold"
    ::= { hddInfoEntry 8 }

hddDeleteLimit OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-write
    STATUS      current
    DESCRIPTION "hard disk driver's usage delete limit threshold"
    ::= { hddInfoEntry 9 }

hddSetLimit OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-write
    STATUS      current
    DESCRIPTION "hard disk driver's usage clear limit threshold"
    ::= { hddInfoEntry 10 }

hddWarnLimit OBJECT-TYPE
	SYNTAX      INTEGER
	MAX-ACCESS  read-write
	STATUS      current
	DESCRIPTION "hard disk driver's usage warning limit threshold"
	::= { hddInfoEntry 11 }

hddAlarmLimit OBJECT-TYPE
	SYNTAX      INTEGER
	MAX-ACCESS  read-write
	STATUS      current
	DESCRIPTION "hard disk driver's usage alarm limit threshold"
	::= { hddInfoEntry 12 }
---
---
--- network information table
---
netConfTable OBJECT-TYPE
    SYNTAX      SEQUENCE OF NetConfEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION "A list of network interface entries."
    ::= { xcnMonitor 7 }

netConfEntry OBJECT-TYPE
    SYNTAX      NetConfEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION "An entry containing management information applicable to a
            particular network interface."
    INDEX   { netConfIndex }
    ::= { netConfTable 1 }

NetConfEntry ::= SEQUENCE {
	netConfIndex 		INTEGER,
	netConfType         OCTET STRING,
	netConfDevice       OCTET STRING,
	netConfMacAddr      OCTET STRING,
	netConfIpAddr       OCTET STRING,
	netConfBcast        OCTET STRING,
	netConfMask         OCTET STRING,
	netConfMtu          OCTET STRING,
	netConfRxByte       OCTET STRING,
	netConfTxByte       OCTET STRING,
	netConfState        INTEGER,
	netConfGatewayIP    OCTET STRING,
	netConfDefaultGW    INTEGER,
	netConfRxCount		OCTET STRING,
	netConfTxCount		OCTET STRING

}

netConfIndex OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION "network interface index."
    ::= { netConfEntry 1 }

netConfType OBJECT-TYPE
    SYNTAX      OCTET STRING
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "The type of interface."
    ::= { netConfEntry 2 }

netConfDevice OBJECT-TYPE
    SYNTAX      OCTET STRING
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "ethernet card device information."
    ::= { netConfEntry 3 }

netConfMacAddr OBJECT-TYPE
    SYNTAX      OCTET STRING
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "ethernet card MAC address."
    ::= { netConfEntry 4 }

netConfIpAddr OBJECT-TYPE
    SYNTAX      OCTET STRING (SIZE (7..15))
    MAX-ACCESS  read-write
    STATUS      current
    DESCRIPTION "ethernet card IP address."
    ::= { netConfEntry 5 }

netConfBcast OBJECT-TYPE
    SYNTAX      OCTET STRING (SIZE (7..15))
    MAX-ACCESS  read-write
    STATUS      current
    DESCRIPTION "ethernet card broadcast IP address."
    ::= { netConfEntry 6 }

netConfMask OBJECT-TYPE
    SYNTAX      OCTET STRING (SIZE (7..15))
    MAX-ACCESS  read-write
    STATUS      current
    DESCRIPTION "ethernet card netmask."
    ::= { netConfEntry 7 }

netConfMtu OBJECT-TYPE
    SYNTAX      OCTET STRING
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "Maximum Transfer Unit"
    ::= { netConfEntry 8 }

netConfRxByte OBJECT-TYPE
    SYNTAX      OCTET STRING
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "Receive packets."
    ::= { netConfEntry 9 }

netConfTxByte OBJECT-TYPE
    SYNTAX      OCTET STRING
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "Transfer packets."
    ::= { netConfEntry 10 }

netConfState OBJECT-TYPE
    SYNTAX      INTEGER { down(0), up(1) }
    MAX-ACCESS  read-write
    STATUS      current
    DESCRIPTION "Interface state."
    ::= { netConfEntry 11 }

netConfGatewayIP OBJECT-TYPE
    SYNTAX      OCTET STRING (SIZE (7..15))
    MAX-ACCESS  read-write
    STATUS      current
    DESCRIPTION "Gateway IP address."
    ::= { netConfEntry 12 }

netConfDefaultGW OBJECT-TYPE
    SYNTAX      INTEGER { none(0), default(1) }
    MAX-ACCESS  read-write
    STATUS      current
    DESCRIPTION "Indicate default Gateway or not."
    ::= { netConfEntry 13 }

netConfRxCount OBJECT-TYPE
    SYNTAX      OCTET STRING
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "Receive packet counts"
    ::= { netConfEntry 14 }

netConfTxCount OBJECT-TYPE
    SYNTAX      OCTET STRING
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "Transfer packet counts."
    ::= { netConfEntry 15 }

---
--- Process information list
---
procListTable OBJECT-TYPE
    SYNTAX      SEQUENCE OF ProcListEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION "Processor list table."
    ::= { xcnMonitor 8 }

procListEntry OBJECT-TYPE
    SYNTAX      ProcListEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION "Processor list  entry"
    INDEX       { procListIndex }
    ::= { procListTable 1 }

ProcListEntry ::= SEQUENCE {
	procListIndex		INTEGER,
	procListName		OCTET STRING,
	procListMemShare	INTEGER,
	procListCpuShare	INTEGER,
	procListCnt			INTEGER,
	procListKillCmd		INTEGER
}

procListIndex OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION "Processor list entry index."
    ::= { procListEntry 1 }

procListName OBJECT-TYPE
    SYNTAX      OCTET STRING
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "Processor name"
    ::= { procListEntry 2 }

procListMemShare OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "Processor memory share"
    ::= { procListEntry 3 }

procListCpuShare OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "Processor cpu share"
    ::= { procListEntry 4 }

procListCnt OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "Processor count"
    ::= { procListEntry 5 }

procListKillCmd OBJECT-TYPE
    SYNTAX      INTEGER 
    MAX-ACCESS  read-write
    STATUS      current
    DESCRIPTION "processor kill command"
    ::= { procListEntry 6 }

--- 
--- Routing Table
--- 
routeTable OBJECT-TYPE
    SYNTAX      SEQUENCE OF RouteEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION "Route information table."
    ::= { xcnMonitor 9 }
    
routeEntry OBJECT-TYPE
    SYNTAX      RouteEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION "Route information entry."
    INDEX       { routeIndex }
    ::= { routeTable 1 }
    
RouteEntry ::= SEQUENCE {
    routeIndex        INTEGER,
    routeDestination  OCTET STRING,
    routeGateway      OCTET STRING,
    routeGenMask      OCTET STRING,
    routeFlags        OCTET STRING,
    routeMetric       INTEGER,
    routeUse          INTEGER,
    routeInterface    OCTET STRING
}   
    
routeIndex OBJECT-TYPE
    SYNTAX      INTEGER 
    MAX-ACCESS  not-accessible
    STATUS      current 
    DESCRIPTION "Route table entry index."
    ::= { routeEntry 1 }

routeDestination OBJECT-TYPE
    SYNTAX      OCTET STRING (SIZE (7..15))
    MAX-ACCESS  read-write
    STATUS      current
    DESCRIPTION "The value against which the destination IP address is matched."
    ::= { routeEntry 2 }

routeGateway OBJECT-TYPE
    SYNTAX      OCTET STRING (SIZE (7..15))
    MAX-ACCESS  read-write
    STATUS      current
    DESCRIPTION "The router to use to reach the specified destination."
    ::= { routeEntry 3 }

routeGenMask OBJECT-TYPE
    SYNTAX      OCTET STRING (SIZE (7..15))
    MAX-ACCESS  read-write
    STATUS      current
    DESCRIPTION "The address mask used to match an IP address to the value shown in the Destination field."
    ::= { routeEntry 4 }

routeFlags OBJECT-TYPE
    SYNTAX      OCTET STRING
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "Certain characteristics of this route."
    ::= { routeEntry 5 }

routeMetric OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-write
    STATUS      current
    DESCRIPTION "The cost of the route. The metric is used to sort duplicate routes if any appear in the table."
    ::= { routeEntry 6 }

routeUse OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "The number of times this route was looked up by IP."
    ::= { routeEntry 7 }

routeInterface OBJECT-TYPE
    SYNTAX      OCTET STRING
    MAX-ACCESS  read-write
    STATUS      current
    DESCRIPTION "Interface Name."
    ::= { routeEntry 8 }

