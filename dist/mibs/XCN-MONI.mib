--- iif traffic
---
iifTrafficTable OBJECT-TYPE
    SYNTAX      SEQUENCE OF IifTrafficEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION "table of Iif Traffic."
    ::= { xcnMonitor 10 } 

iifTrafficEntry OBJECT-TYPE
    SYNTAX      IifTrafficEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION "Iif Traffic entry."
    INDEX       { iifTrafficIndex }
    ::= { iifTrafficTable 1 } 

IifTrafficEntry ::= SEQUENCE {
    iifTrafficIndex   	   	INTEGER,
    iifTrafficPort			OCTET STRING,
    iifTrafficDirection     INTEGER,
    iifTrafficState      	INTEGER,
    iifTrafficTotalCnt      OCTET STRING,
    iifTrafficTotalSize     OCTET STRING,
    iifTrafficDailyCnt      OCTET STRING,
    iifTrafficDailySize     OCTET STRING,
	iifTraffic10MinCnt	OCTET STRING,
	iifTraffic10MinSize    	OCTET STRING,
	iifTrafficSecCnt     	OCTET STRING,
	iifTrafficSecSize      	OCTET STRING,
	iifTraffic10MinRxCnt	OCTET STRING,
	iifTraffic10MinRxSize  	OCTET STRING,
	iifTraffic10MinTxCnt	OCTET STRING,
	iifTraffic10MinTxSize  	OCTET STRING
}

iifTrafficIndex OBJECT-TYPE
    SYNTAX      INTEGER
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION "iif traffic table entry index."
