iifTrafficDailyCnt OBJECT-TYPE
    SYNTAX      OCTET STRING
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "iif mirroring port daily packet counts"
    ::= { iifTrafficEntry 7 }

iifTrafficDailySize OBJECT-TYPE
    SYNTAX      OCTET STRING
    MAX-ACCESS  read-only
    STATUS      current
